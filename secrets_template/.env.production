# MathGenius Production Environment Variables
# COPY THIS FILE TO .env.production AND FILL IN ALL VALUES
# NEVER COMMIT THIS FILE WITH REAL VALUES

###############################################################################
# FRONTEND (Vite) - These are exposed to the browser (VITE_ prefix)
###############################################################################
VITE_API_URL=https://api.mathgenius.guru
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

###############################################################################
# BACKEND - Server-side only (NEVER expose to frontend)
###############################################################################

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Supabase (keep for Auth + Storage + Realtime)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Nobus Managed PostgreSQL (from instance creation - SAVE THE PASSWORD!)
# Format: postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://mathgenius_admin:YOUR_DB_PASSWORD@your-cluster.nobus-db.io:5432/mathgenius?sslmode=require

# Email (cPanel mailbox - already working)
SMTP_HOST=mathgenius.guru
SMTP_PORT=465
SMTP_USER=noreply@mathgenius.guru
SMTP_PASSWORD=your_noreply_mailbox_password_here
SMTP_REPLY_TO=help@mathgenius.guru

# Admin
ADMIN_EMAILS=your_gmail@gmail.com,teammate_gmail@gmail.com
FRONTEND_URL=https://mathgenius.guru

# Nobus
NOBUS_API_TOKEN=your_nobus_api_token_here
NOBUS_PROJECT_ID=your_nobus_project_id_here

# App
ENVIRONMENT=production
FRONTEND_URL=https://mathgenius.guru
ADMIN_EMAILS=your_gmail@gmail.com
ADMIN_EMAIL=help@mathgenius.guru
SMTP_REPLY_TO=help@mathgenius.guru

###############################################################################
# NOBUS DATABASE CREDENTIALS (Generated at instance creation - SAVE IMMEDIATELY!)
###############################################################################
# NOBUS DATABASE (Generated at instance creation - SAVE IMMEDIATELY!)
# Host: <cluster-id>.nobus-db.io
# Port: 5432
# Database: mathgenius
# Username: mathgenius_admin
# Password: <AUTO-GENERATED - SAVE IMMEDIATELY!>
# 
# DATABASE_URL format:
# postgresql://mathgenius_admin:PASSWORD@host:5432/mathgenius?sslmode=require

# SMTP (cPanel mailbox - already working)
SMTP_HOST=mathgenius.guru
SMTP_PORT=465
SMTP_USER=noreply@mathgenius.guru
SMTP_PASSWORD=your_noreply_mailbox_password_here
SMTP_REPLY_TO=help@mathgenius.guru

# Admin emails (for control room access)
ADMIN_EMAILS=your_gmail@gmail.com,teammate_gmail@gmail.com
ADMIN_EMAIL=help@mathgenius.guru
SMTP_REPLY_TO=help@mathgenius.guru
FRONTEND_URL=https://mathgenius.guru

# App
ENVIRONMENT=production
FRONTEND_URL=https://mathgenius.guru